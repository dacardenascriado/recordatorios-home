# Copiar a .env para pruebas locales. .env está en .gitignore: nunca lo subas.
# En GitHub estos mismos valores van en
# Settings > Secrets and variables > Actions > New repository secret.

# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat destino. Para tu chat privado con el bot es un número positivo;
# para un grupo es negativo (ej. -1001234567890).
TELEGRAM_CHAT_ID=123456789

# Cadena de conexión de Neon. Si la dejás vacía, se usa un SQLite local
# (recordatorios.db) — sirve para probar, pero no para producción.
DATABASE_URL=postgresql://usuario:clave@ep-algo.us-east-2.aws.neon.tech/recordatorios?sslmode=require

# Los nombres de las personas. No se escriben en reminders.yaml porque el repo
# es público; el YAML los referencia como ${PERSONA_1}..${PERSONA_4}. Al ser
# secrets, GitHub además los enmascara en los logs de Actions.
PERSONA_1=Nombre1
PERSONA_2=Nombre2
PERSONA_3=Nombre3
PERSONA_4=Nombre4

# Opcionales
# REMINDERS_FILE=reminders.yaml

# Ventana de recuperación en minutos (por defecto 120): cuánto tolera que
# GitHub Actions se atrase antes de dar un recordatorio por perdido. Subirlo
# también alarga el rato que Neon queda despierta después de cada envío.
# TICK_LOOKBACK_MINUTES=120

# Tope duro de esa ventana, en horas (por defecto 6).
# TICK_MAX_WINDOW_HOURS=6
